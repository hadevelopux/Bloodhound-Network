# ==========================================================
# CONFIGURACIÓN DEL SENSOR (ROGUE AP)
# ==========================================================
C_IFACE=enp0s10
W_IFACE=wlp3s0b1
LAB_IP=192.168.100.1
LAB_RANGE=192.168.100.2,192.168.100.200
WIFI_SSID=TroyanoMedia
WIFI_PASSWORD=01*00*00*01
DNS_LAB=1.1.1.1,1.0.0.1
ROUTER_CASA=192.168.1.1,192.168.0.1
ENABLE_DEBUG_LOGS=true

# ==========================================================
# CONFIGURACIÓN DE RED LOCAL (BRIDGE TRANSPARENTE)
# ==========================================================
# Interfaz donde el Sniffer escuchará pasivamente todo el tráfico
L_IFACE=br0